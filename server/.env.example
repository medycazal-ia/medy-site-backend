# Port d'écoute de l'API
PORT=4200

# Nom affiché dans l'interface d'administration
BRAND_NAME=medy.site

# --- Connexion (identifiants admin, obligatoires au premier démarrage) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi
SESSION_SECRET=une-longue-chaine-aleatoire-a-changer

# --- CRM (gestion clients), stocké dans Airtable ---
# Personal Access Token Airtable (airtable.com/create/tokens) avec les scopes
# data.records:read, data.records:write, schema.bases:read, restreint à la
# base "Medy CRM — Clients & Projets". Sans cette clé, /api/crm/* répond 500.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app2Zji7fTJLN9aAg
