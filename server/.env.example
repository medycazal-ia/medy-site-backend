# Port d'écoute de l'API
PORT=4200

# Nom affiché dans l'interface d'administration
BRAND_NAME=medy.site

# --- Connexion (identifiants admin, obligatoires au premier démarrage) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi
SESSION_SECRET=une-longue-chaine-aleatoire-a-changer

# --- CRM (gestion clients), stocké dans Airtable ---
# Personal Access Token Airtable (airtable.com/create/tokens) avec les scopes
# data.records:read, data.records:write, schema.bases:read, restreint à la
# base "Medy CRM — Clients & Projets". Sans cette clé, /api/crm/* répond 500.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app2Zji7fTJLN9aAg

# --- Messagerie/téléphonie (SMS, WhatsApp, clic-pour-appeler), via Twilio ---
# Console Twilio : console.twilio.com (Account SID + Auth Token en page d'accueil)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio (acheté dans la console) : envoie les SMS et sert d'appelant
# pour le clic-pour-appeler.
TWILIO_SMS_FROM=
# Expéditeur WhatsApp : le sandbox Twilio (+14155238886) pour tester avant
# validation Meta Business, ou un numéro WhatsApp Business approuvé ensuite.
TWILIO_WHATSAPP_FROM=
# Le téléphone de Medy — pour un clic-pour-appeler, Twilio l'appelle d'abord
# puis relie l'appel au client une fois décroché.
TWILIO_MY_PHONE_NUMBER=
# URL publique de CE service une fois déployé (ex: https://medy-site-backend.onrender.com) :
# indispensable pour que Twilio puisse rappeler nos webhooks (TwiML, réception).
# Ne fonctionne pas en local sans tunnel public (ex: ngrok).
PUBLIC_BASE_URL=

# --- Email (envoi depuis le CRM), via Resend ---
# Compte gratuit sur resend.com : Dashboard > API Keys > Create API Key.
RESEND_API_KEY=
# onboarding@resend.dev fonctionne sans domaine vérifié (pratique pour tester
# tout de suite) ; une adresse sur un domaine vérifié dans Resend (ex:
# contact@medy.site) est plus crédible en production.
EMAIL_FROM=onboarding@resend.dev
